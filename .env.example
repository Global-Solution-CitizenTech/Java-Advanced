# ========================================================
# ZelaFix API & Worker - Variaveis de Ambiente (.env.example)
# ========================================================

# Porta da API e Worker
PORT=8080
WORKER_PORT=8081

# Banco de Dados Oracle FIAP
ORACLE_URL=jdbc:oracle:thin:@//oracle.fiap.com.br:1521/orcl
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DRIVER=oracle.jdbc.OracleDriver
JPA_DDL_AUTO=none
JPA_SHOW_SQL=false

# RabbitMQ (CloudAMQP - plano gratuito Little Lemur)
# Formato: amqps://USUARIO:SENHA@HOST/VHOST
SPRING_RABBITMQ_ADDRESSES=

# Spring AI (Azure AI Foundry para Triagem Multimodal com Phi-4 Multimodal)
AI_BASE_URL=https://ai-zelafix-561432.services.ai.azure.com/openai/v1
AI_API_KEY=
AI_MODEL=phi-4-multimodal
