# ========================================================
# ZelaFix API & Worker - Variaveis de Ambiente (.env.example)
# ========================================================

# Porta da API e Worker
PORT=8080
WORKER_PORT=8081

# Banco de Dados Oracle (Local Docker: jdbc:oracle:thin:@//localhost:1521/FREEPDB1 ou FIAP)
ORACLE_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
ORACLE_USER=zelafix
ORACLE_PASSWORD=zelafix
ORACLE_DRIVER=oracle.jdbc.OracleDriver
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# RabbitMQ (Opcao A - Mensageria)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Spring AI (Groq API para Triagem Multimodal com Qwen)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
