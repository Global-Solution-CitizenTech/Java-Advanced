# ========================================================
# ZelaFix API - Variaveis de Ambiente (.env)
# ========================================================

# Porta da API
PORT=8080

# Banco de Dados Oracle (Nuvem / FIAP)
# Deixe vazio para usar H2 em memoria com sintaxe Oracle automaticamente
ORACLE_URL=
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DRIVER=oracle.jdbc.OracleDriver
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# RabbitMQ (Opcao A - Mensageria)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Spring AI (Chave OpenAI para Triagem Inteligente)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

